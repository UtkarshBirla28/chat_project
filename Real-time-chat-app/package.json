{
	"name": "chatterbox-backend",
	"version": "1.0.0",
	"description": "ChatterBox real-time chat API (Express + Socket.io + Prisma/Postgres)",
	"main": "backend/server.js",
	"scripts": {
		"server": "nodemon backend/server.js",
		"start": "node backend/server.js",
		"build": "npm install && npx prisma generate --schema=backend/prisma/schema.prisma && npx prisma migrate deploy --schema=backend/prisma/schema.prisma",
		"db:generate": "npx prisma generate --schema=backend/prisma/schema.prisma",
		"db:migrate": "npx prisma migrate dev --schema=backend/prisma/schema.prisma"
	},
	"type": "module",
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@prisma/client": "^6.3.1",
		"bcryptjs": "^2.4.3",
		"cloudinary": "^2.5.1",
		"cookie-parser": "^1.4.6",
		"cors": "^2.8.5",
		"dotenv": "^16.4.1",
		"express": "^4.18.2",
		"express-fileupload": "^1.5.1",
		"jsonwebtoken": "^9.0.2",
		"socket.io": "^4.7.4"
	},
	"devDependencies": {
		"nodemon": "^3.0.3",
		"prisma": "^6.3.1"
	}
}
